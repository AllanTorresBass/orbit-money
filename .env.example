# Neon / Postgres — copy to .env and fill in (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Auth.js — required in production (min 16 chars)
AUTH_SECRET=replace-me-with-a-long-random-string

# Vercel Cron bearer for /api/v1/cron/midnight
CRON_SECRET=replace-me

# Local only: allow x-user-id / x-tenant-id actor switching (never enable in production)
ALLOW_DEV_HEADER_AUTH=true
NEXT_PUBLIC_ALLOW_DEV_HEADER_AUTH=true
