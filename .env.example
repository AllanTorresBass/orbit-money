# Neon / Postgres — copy to .env and fill in (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Auth.js — required in production (min 16 chars)
AUTH_SECRET=replace-me-with-a-long-random-string

# Magic-link (Resend). Needs migration 007 (verification_token). When both keys are set the
# server registers the Resend provider. Set NEXT_PUBLIC_MAGIC_LINK=true ONLY when both keys
# exist so the sign-in page shows "Email me a link". Leave unset/false otherwise.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=onboarding@resend.dev
# NEXT_PUBLIC_MAGIC_LINK=true

# Vercel Cron bearer for /api/v1/cron/midnight
CRON_SECRET=replace-me

# Local only: allow x-user-id / x-tenant-id actor switching (never enable in production)
ALLOW_DEV_HEADER_AUTH=true
NEXT_PUBLIC_ALLOW_DEV_HEADER_AUTH=true
